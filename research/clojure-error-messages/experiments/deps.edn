{:paths ["."]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}
 :aliases
 {:clj18  {:override-deps {org.clojure/clojure {:mvn/version "1.8.0"}}}
  :clj19  {:override-deps {org.clojure/clojure {:mvn/version "1.9.0"}}}
  :clj110 {:override-deps {org.clojure/clojure {:mvn/version "1.10.3"}}}
  :clj111 {:override-deps {org.clojure/clojure {:mvn/version "1.11.4"}}}
  :clj113 {:override-deps {org.clojure/clojure {:mvn/version "1.13.0-alpha6"}}}
  :expound {:extra-deps {expound/expound {:mvn/version "0.9.0"}}}
  :pretty  {:extra-deps {org.clj-commons/pretty {:mvn/version "3.8.0"}}}
  :proto   {:extra-deps {nice-errors/nice-errors {:local/root "../prototype"} expound/expound {:mvn/version "0.9.0"}}
            :extra-paths ["dev"]}
  :rephrase {:extra-deps {org.corfield/rephrase {:mvn/version "1.0.4"}} :extra-paths ["dev-rephrase"]}
  :stacktrace {:extra-deps {clj-stacktrace/clj-stacktrace {:mvn/version "0.2.8"}}}}}
