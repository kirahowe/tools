{
  "name": "kirahowe-tools",
  "version": "1.0.0",
  "description": "A monorepo of small web tools, deployed to tools.kirahowe.com/<tool> via Cloudflare Pages.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
